# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
PORT=3000
# Number of proxies in front of the app. Leave unset if there are none.
# TRUST_PROXY=1

# memory | mongo | postgres
DB_DRIVER=memory

# MongoDB (DB_DRIVER=mongo)  -> npm install mongodb
MONGO_URL=mongodb://localhost:27017
MONGO_DB=auth

# PostgreSQL (DB_DRIVER=postgres)  -> npm install pg
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth

# Your frontend's address, used in email links
APP_URL=http://localhost:5173
APP_NAME=My App

# Email. Without SMTP_URL, the example prints links to the console instead.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM="My App <no-reply@example.com>"

# Keep the refresh token in an httpOnly cookie (for browser apps)
# COOKIE_LOGIN=true
# Only for local development over plain HTTP
# COOKIE_SECURE=false

# Give this registered user the admin role at startup
# ADMIN_EMAIL=you@example.com
